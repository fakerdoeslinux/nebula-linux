--- a/runtime/include/galaxy/platform_time.h
+++ b/runtime/include/galaxy/platform_time.h
@@ -2,23 +2,44 @@
 #pragma once
 
 // The runtime's high-resolution clock in ticks of qpc_frequency() per second: QueryPerformanceCounter on Windows,
-// CLOCK_MONOTONIC nanoseconds elsewhere.
+// CLOCK_MONOTONIC nanoseconds elsewhere, Xenon's time base (a 50 MHz counter that both cores and the GPU keep) on
+// Xbox 360.
 
 #include <cstdint>
 
 #if defined(_WIN32)
 #include "galaxy/windows_api.h"
+#elif defined(NEBULA_XBOX360)
+// Xenon's time base: mftbu/mftb. No header of its own.
 #else
 #include <time.h>
 #endif
 
 namespace galaxy {
 
+#if defined(NEBULA_XBOX360)
+// The console's 64-bit time base register. Read in the order the PowerPC requires: the upper word, the lower, and the
+// upper again to catch the carry, else a read landing across the wrap returns a value 4 billion ticks late.
+[[nodiscard]] inline std::uint64_t xbox360_time_base() noexcept {
+    std::uint32_t upper = 0u;
+    std::uint32_t lower = 0u;
+    std::uint32_t again = 0u;
+    do {
+        __asm__ volatile("mftbu %0" : "=r"(upper));
+        __asm__ volatile("mftb %0" : "=r"(lower));
+        __asm__ volatile("mftbu %0" : "=r"(again));
+    } while (upper != again);
+    return (static_cast<std::uint64_t>(upper) << 32u) | lower;
+}
+#endif
+
 [[nodiscard]] inline std::int64_t qpc_now() noexcept {
 #if defined(_WIN32)
     LARGE_INTEGER now{};
     QueryPerformanceCounter(&now);
     return now.QuadPart;
+#elif defined(NEBULA_XBOX360)
+    return static_cast<std::int64_t>(xbox360_time_base());
 #else
     timespec now{};
     clock_gettime(CLOCK_MONOTONIC, &now);
@@ -34,6 +55,8 @@ namespace galaxy {
         return static_cast<std::int64_t>(value.QuadPart);
     }();
     return frequency;
+#elif defined(NEBULA_XBOX360)
+    return 50000000;  // Xenon's time base ticks at 50 MHz, on every core
 #else
     return 1000000000;
 #endif
