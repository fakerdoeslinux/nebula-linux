diff --git a/cmake/archive_deps.cmake b/cmake/archive_deps.cmake
index bc15be8..940541f 100644
--- a/cmake/archive_deps.cmake
+++ b/cmake/archive_deps.cmake
@@ -32,6 +32,12 @@ function(nebula_archive_dep name source)
     if(CMAKE_OSX_DEPLOYMENT_TARGET)
         list(APPEND toolchain "-DCMAKE_OSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}")
     endif()
+    # Fedora-style multilibs install static archives into lib64, while the libraries the build links are named
+    # under lib/ below. Windows already installs into lib.
+    set(libdir)
+    if(NOT WIN32)
+        set(libdir "-DCMAKE_INSTALL_LIBDIR=lib")
+    endif()
     execute_process(
         COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G "${CMAKE_GENERATOR}"
                 "-DCMAKE_BUILD_TYPE=Release"
@@ -40,6 +46,7 @@ function(nebula_archive_dep name source)
                 "-DCMAKE_PREFIX_PATH=${NEBULA_ARCHIVE_PREFIX}"
                 "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
                 "-DBUILD_SHARED_LIBS=OFF"
+                ${libdir}
                 ${toolchain} ${ARGN}
         RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE errors)
     if(NOT result EQUAL 0)
