diff --git a/runtime/include/galaxy/ui_sounds.h b/runtime/include/galaxy/ui_sounds.h
new file mode 100644
index 0000000..196ba1f
--- /dev/null
+++ b/runtime/include/galaxy/ui_sounds.h
@@ -0,0 +1,55 @@
+// The settings menu's own sounds (nebula_game_api.h ui_sound): short 16-bit WAV files the player keeps beside the
+// game's other data, played by the host's mixer rather than by the game.
+//
+// The game's own effects cannot carry the menu: while it is open the game fades its music and its streams to silence
+// (AudSystem::holdForSettingsMenu), and a sound the player drops in as a mod is a stream. These are mixed straight into
+// the output frame, at the effects volume, so the effects slider and the master both reach them.
+//
+// The files are `<data>/menu-sounds/<role>.wav`, one per role below; a role whose file is missing (or is not 16-bit
+// PCM) stays silent and the game falls back to its own effect.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+
+namespace galaxy::host {
+
+// The menu's sounds. The host and the game share these numbers (nebula_game_api.h NEBULA_UI_SOUND_*).
+enum UiSoundId : std::uint32_t {
+    kUiSoundFocus = 0,   // the highlight arrives at something
+    kUiSoundSelect = 1,  // a value changes, a mod is dropped
+    kUiSoundPage = 2,    // another page
+    kUiSoundOpen = 3,    // the menu opens
+    kUiSoundClose = 4,   // the menu closes
+    kUiSoundOk = 5,      // a change is applied
+    kUiSoundCount = 6,
+};
+
+class UiSounds {
+public:
+    UiSounds();
+    ~UiSounds();
+    UiSounds(const UiSounds&) = delete;
+    UiSounds& operator=(const UiSounds&) = delete;
+
+    // Reads the WAVs of `<data>/menu-sounds` (runtime_settings_folder), or of `folder` when it is given. Roles whose
+    // file is missing stay silent. Safe to call before any device opens; calling it again replaces what was loaded.
+    void load(const char* folder = nullptr);
+    // The roles this load found, for the log ("focus select page"), empty when it found none.
+    [[nodiscard]] const char* loaded() const;
+
+    // Queues `id` for the next frame. Any thread; safe before the device pulls. True when the file is there (it will be
+    // heard), false when it is not.
+    bool play(std::uint32_t id);
+
+    // Adds every voice queued or still sounding into `out` (interleaved stereo, `frames` long), at a gain ramped from
+    // `gain_start` to `gain_end` across the frame. The device's thread.
+    void mix(float* out, std::size_t frames, std::uint32_t rate, float gain_start, float gain_end);
+
+private:
+    struct State;
+    std::unique_ptr<State> state_;
+};
+
+}  // namespace galaxy::host
diff --git a/runtime/src/asset_store.cpp b/runtime/src/asset_store.cpp
index 603cf48..fe8fdd5 100644
--- a/runtime/src/asset_store.cpp
+++ b/runtime/src/asset_store.cpp
@@ -2,6 +2,7 @@
 
 #include <algorithm>
 #include <array>
+#include <bit>
 #include <cctype>
 #include <cstring>
 
@@ -19,10 +20,83 @@ namespace {
 
 constexpr std::size_t kHeader = 64;
 
+// The store is little-endian whatever reads it (cook/store.rs). On a big-endian machine (the Xbox 360's Xenon) the words
+// are byte-reversed on the way out of the index; the tables themselves are converted once, in place
+// (host_index_order), because their fields are only ever read.
+inline constexpr bool kHostIsBigEndian = std::endian::native == std::endian::big;
+
+std::uint32_t tail32(std::uint32_t value) noexcept {
+    if constexpr (!kHostIsBigEndian) {
+        return value;
+    }
+    return (value >> 24u) | ((value >> 8u) & 0x0000ff00u) | ((value << 8u) & 0x00ff0000u) | (value << 24u);
+}
+
+std::uint64_t tail64(std::uint64_t value) noexcept {
+    if constexpr (!kHostIsBigEndian) {
+        return value;
+    }
+    return (static_cast<std::uint64_t>(tail32(static_cast<std::uint32_t>(value))) << 32u) |
+           tail32(static_cast<std::uint32_t>(value >> 32u));
+}
+
+std::uint32_t word32(const std::uint8_t* at) {
+    std::uint32_t value;
+    std::memcpy(&value, at, sizeof(value));
+    return tail32(value);
+}
+
 std::uint64_t word(const std::uint8_t* at) {
     std::uint64_t value;
     std::memcpy(&value, at, sizeof(value));
-    return value;
+    return tail64(value);
+}
+
+void host_u32(std::uint8_t* at) {
+    std::uint32_t value;
+    std::memcpy(&value, at, sizeof(value));
+    value = tail32(value);
+    std::memcpy(at, &value, sizeof(value));
+}
+
+void host_u64(std::uint8_t* at) {
+    std::uint64_t value;
+    std::memcpy(&value, at, sizeof(value));
+    value = tail64(value);
+    std::memcpy(at, &value, sizeof(value));
+}
+
+// A store's index (the node table, the hash table, the names) brought to the machine's own order: the header's words are
+// read through word()/word32(), and this is the tables' one conversion. Little-endian machines return untouched; a
+// big-endian machine swaps each node's 8- and 4-byte fields and each hash's, leaving the names' bytes alone.
+void host_index_order(std::uint8_t* table, std::uint64_t size, std::uint64_t nodes_at, std::uint64_t hashes_at,
+                      std::uint32_t count) noexcept {
+    if constexpr (!kHostIsBigEndian) {
+        (void)table;
+        (void)size;
+        (void)nodes_at;
+        (void)hashes_at;
+        (void)count;
+        return;
+    }
+    for (std::uint32_t i = 0u; i < count; ++i) {
+        std::uint8_t* const node = table + nodes_at + static_cast<std::uint64_t>(i) * 40u;
+        if (nodes_at + static_cast<std::uint64_t>(i + 1u) * 40u > size) {
+            return;
+        }
+        host_u64(node + 0u);
+        host_u64(node + 8u);
+        for (std::uint32_t field = 16u; field < 40u; field += 4u) {
+            host_u32(node + field);
+        }
+        std::uint8_t* const hash = table + hashes_at + static_cast<std::uint64_t>(i) * 16u;
+        if (hashes_at + static_cast<std::uint64_t>(i + 1u) * 16u > size) {
